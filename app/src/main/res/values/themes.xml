<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.StylishLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>

        <!-- Accent -->
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorTertiaryVariant">@color/brand_accent_light</item>
        <item name="colorOnTertiary">@color/brand_on_primary</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_on_background</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/brand_on_primary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline_variant</item>

        <!-- Scrim -->
        <item name="colorScrim">@color/scrim</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.StylishLauncher.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.StylishLauncher.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StylishLauncher.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.StylishLauncher.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.StylishLauncher.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.StylishLauncher.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StylishLauncher.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.StylishLauncher.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.StylishLauncher.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.StylishLauncher.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.StylishLauncher.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.StylishLauncher.LabelSmall</item>

        <!-- Shapes -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.StylishLauncher.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.StylishLauncher.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.StylishLauncher.Large</item>
    </style>

    <!-- Light Theme Override -->
    <style name="Theme.StylishLauncher.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorPrimaryVariant">@color/light_primary_variant</item>
        <item name="colorOnPrimary">@color/light_on_primary</item>
        <item name="colorSecondary">@color/light_secondary</item>
        <item name="colorOnSecondary">@color/light_on_secondary</item>
        <item name="colorTertiary">@color/light_accent</item>
        <item name="colorOnTertiary">@color/light_on_primary</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_on_background</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/light_on_primary</item>
        <item name="colorOutline">@color/light_outline</item>
        <item name="colorOutlineVariant">@color/light_outline_variant</item>
        <item name="colorScrim">@color/scrim</item>
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Dark Theme Override -->
    <style name="Theme.StylishLauncher.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_variant</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/dark_on_secondary</item>
        <item name="colorTertiary">@color/dark_accent</item>
        <item name="colorOnTertiary">@color/dark_on_primary</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/dark_on_primary</item>
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline_variant</item>
        <item name="colorScrim">@color/scrim</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.SplashScreen" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.StylishLauncher</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.StylishLauncher.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.StylishLauncher.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textWeight">600</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.StylishLauncher.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textWeight">600</item>
    </style>

    <style name="TextAppearance.StylishLauncher.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textWeight">600</item>
    </style>

    <style name="TextAppearance.StylishLauncher.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textWeight">500</item>
    </style>

    <style name="TextAppearance.StylishLauncher.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textWeight">500</item>
    </style>

    <style name="TextAppearance.StylishLauncher.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textWeight">400</item>
    </style>

    <style name="TextAppearance.StylishLauncher.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textWeight">400</item>
    </style>

    <style name="TextAppearance.StylishLauncher.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textWeight">400</item>
    </style>

    <style name="TextAppearance.StylishLauncher.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textWeight">500</item>
    </style>

    <style name="TextAppearance.StylishLauncher.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textWeight">500</item>
    </style>

    <style name="TextAppearance.StylishLauncher.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textWeight">500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.StylishLauncher.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.StylishLauncher.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.StylishLauncher.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>